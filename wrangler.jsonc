{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-great-race",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-17",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-great-race",
      // Replace this with the ID returned by `npx wrangler d1 create the-great-race`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "the-great-race-preview",
          // Use a separate preview database. Never point previews at production data.
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "cloudflare/migrations",
        },
      ],
    },
  },
}
