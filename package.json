{
  "name": "the-great-race",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "npm run build && npm start",
    "test": "node --test test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "links:check": "node --env-file-if-exists=.env scripts/check-links.js",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:pages": "npm run build && wrangler pages functions build --outdir .wrangler/pages-build",
    "pages:dev": "wrangler pages dev public",
    "pages:migrate:local": "wrangler d1 migrations apply DB --local",
    "pages:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:pages": "node --test cloudflare-tests/*.test.js",
    "test:browser:pages": "node scripts/test-pages-browser.js",
    "check:scheduler": "wrangler deploy --config wrangler.scheduler.jsonc --dry-run --outdir .wrangler/scheduler-build",
    "pages:check-config": "node scripts/check-pages-config.js",
    "deploy": "wrangler deploy --config wrangler.worker.jsonc",
    "check:worker": "wrangler deploy --config wrangler.worker.jsonc --dry-run --outdir .wrangler/worker-build",
    "worker:dev": "wrangler dev --config wrangler.worker.jsonc",
    "worker:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.worker.jsonc",
    "worker:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.worker.jsonc",
    "test:browser:worker": "node scripts/test-worker-browser.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "wrangler": "4.151.1"
  }
}
