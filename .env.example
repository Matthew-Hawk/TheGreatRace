# Copy to .env. Public browsing works without editor accounts.
PORT=4180
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4180
DATABASE_PATH=./data/great-race.sqlite
# Choose different passwords of at least 12 characters. Never commit .env.
RESEARCHER_PASSWORD=
REVIEWER_PASSWORD=
# Set true only behind an HTTPS reverse proxy.
COOKIE_SECURE=false
